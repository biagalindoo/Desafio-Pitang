generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String                  @id @default(cuid())
  nome           String
  email          String                  @unique
  senha          String
  perfil         String
  criadoEm       DateTime                @default(now())
  atualizadoEm   DateTime                @updatedAt
  solicitacoes   SolicitacaoReembolso[]  @relation("RequesterRequests")
  historicos     RequestHistory[]

  @@map("usuarios")
}

model Category {
  id             String                  @id @default(cuid())
  nome           String                  @unique
  ativo          Boolean                 @default(true)
  criadoEm       DateTime                @default(now())
  atualizadoEm   DateTime                @updatedAt
  solicitacoes   SolicitacaoReembolso[]

  @@map("categorias")
}

model SolicitacaoReembolso {
  id                     String                @id @default(cuid())
  solicitanteId          String
  categoriaId            String
  descricao              String
  valor                  Decimal
  dataDespesa            DateTime
  status                 String                @default("RASCUNHO")
  justificativaRejeicao  String?
  criadoEm               DateTime              @default(now())
  atualizadoEm           DateTime              @updatedAt
  solicitante            User                  @relation("RequesterRequests", fields: [solicitanteId], references: [id])
  categoria              Category              @relation(fields: [categoriaId], references: [id])
  anexos                 Attachment[]
  historicos             RequestHistory[]

  @@map("solicitacoes_reembolso")
}

model Attachment {
  id             String                  @id @default(cuid())
  solicitacaoId  String
  nomeArquivo    String
  urlArquivo     String
  tipoArquivo    String
  criadoEm       DateTime                @default(now())
  solicitacao    SolicitacaoReembolso    @relation(fields: [solicitacaoId], references: [id])

  @@map("anexos")
}

model RequestHistory {
  id             String                  @id @default(cuid())
  solicitacaoId  String
  usuarioId      String
  acao           String
  observacao     String
  criadoEm       DateTime                @default(now())
  solicitacao    SolicitacaoReembolso    @relation(fields: [solicitacaoId], references: [id])
  usuario        User                    @relation(fields: [usuarioId], references: [id])

  @@map("historicos_solicitacao")
}
