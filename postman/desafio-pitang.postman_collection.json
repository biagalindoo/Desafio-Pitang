    {
      "name": "Categorias",
      "item": [
        {
          "name": "Listar categorias",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (Array.isArray(json) && json[0]?.id) { pm.collectionVariables.set('categoriaId', json[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
