    {
      "name": "Reembolsos",
      "item": [
        {
          "name": "Listar com filtros e ordenacao",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reembolsos?status=RASCUNHO&ordenacao=MAIOR_VALOR",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reembolsos"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "RASCUNHO"
                },
                {
                  "key": "ordenacao",
                  "value": "MAIOR_VALOR"
                }
              ]
            }
          }
        },
